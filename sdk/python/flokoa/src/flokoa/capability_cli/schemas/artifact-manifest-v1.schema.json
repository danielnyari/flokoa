{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flokoa.ai/schemas/artifact-manifest-v1.schema.json",
  "title": "Capability artifact manifest (v1)",
  "description": "Self-description of a capability wheelhouse artifact (runtime contract \u00a74). The Capability CR mirrors name/version/entrypoint/serializationName/requires/dependencies/configSchema by value; schemaDigest binds configSchema to the CR mirror.",
  "type": "object",
  "required": [
    "name",
    "version",
    "contractVersion",
    "entrypoint",
    "requires",
    "wheels"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "PEP 503-normalized distribution name"
    },
    "version": {
      "type": "string",
      "description": "PEP 440 version; matches the Capability CR spec.version"
    },
    "contractVersion": {
      "type": "integer",
      "const": 1
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[\\w.]+:[A-Za-z_]\\w*$"
    },
    "serializationName": {
      "type": "string",
      "pattern": "^[A-Za-z_]\\w*$"
    },
    "requires": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "pydantic-ai": {
          "type": "string",
          "description": "PEP 440 specifier set"
        },
        "flokoa-runner": {
          "type": "string",
          "description": "PEP 440 specifier set"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*==[A-Za-z0-9._+!-]+$"
      },
      "description": "pinned non-baseline closure; mirrored to Capability CR spec.dependencies"
    },
    "wheels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "\\.whl$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "schemaDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256 of the canonical (sorted-keys, no-whitespace) configSchema JSON"
    },
    "configSchema": {
      "type": "object",
      "description": "inline JSON Schema for per-agent config (additive optional field)"
    },
    "source": {
      "type": "string",
      "enum": [
        "builtin",
        "image",
        "git",
        "pypi"
      ],
      "default": "image",
      "description": "Where the capability's code came from (additive optional field; default image). Mirrored to Capability CR spec.source."
    },
    "provenance": {
      "type": "object",
      "description": "Origin provenance; shape depends on source. Carries no credential material. Mirrored to Capability CR spec.provenance.",
      "properties": {
        "git": {
          "type": "object",
          "required": [
            "url",
            "commit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "clean repository URL (no embedded credentials)"
            },
            "ref": {
              "type": "string",
              "description": "requested branch, tag, or commit (informational)"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{7,40}$",
              "description": "resolved git commit (the durable provenance record)"
            },
            "subdirectory": {
              "type": "string",
              "description": "path within the repo to the Python project, if any"
            }
          },
          "additionalProperties": false
        },
        "pypi": {
          "type": "object",
          "required": [
            "requirement"
          ],
          "properties": {
            "requirement": {
              "type": "string",
              "description": "resolved PyPI requirement, e.g. some-pkg==1.2.0"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
